# Copy to .env.local and fill in. Never commit .env.local.
ANTHROPIC_API_KEY=
# Default if unset: claude-sonnet-4-6 (good balance of cost / quality for
# structured extraction and short-form narrative). Override with any current
# Claude model id, e.g. claude-opus-4-8 for the narrative pass if desired.
ANTHROPIC_MODEL=claude-sonnet-4-6
