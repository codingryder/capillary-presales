# Copy to .env.local and fill in. Never commit .env.local.
#
# Google AI Studio API key (starts with "AIza...").
# Get one at https://aistudio.google.com/apikey.
GEMINI_API_KEY=

# Optional. Defaults to gemini-2.5-flash. Override with any current
# Gemini model id (e.g. gemini-2.5-pro for higher-quality narrative).
GEMINI_MODEL=gemini-2.5-flash
